# ─────────────────────────────────────────────────────────────
# Workspace-level .gitignore for the Proposal Studio repo.
#
# The application lives in `proposal-studio/` and has its own,
# more specific .gitignore. This file ignores workspace-wide
# build artifacts, local IDE/tool metadata, and scratch captures
# that shouldn't be in source control.
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*

# Next.js build output
.next/
**/.next/
out/
**/out/

# Production builds
build/
**/build/

# Testing
coverage/
**/coverage/

# Env + secrets — never commit these
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Vercel
.vercel/
**/.vercel/

# TypeScript build info
*.tsbuildinfo
**/*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# OS
.DS_Store
**/.DS_Store
Thumbs.db

# IDE / tool metadata
.idea/
.vscode/
.cursor/projects/
.cursor/logs/
.cursor/chat-history/
# Cursor skills are tool-level scaffolding (imagegen, openai-docs,
# frontend-design, etc.) — not part of the app source. Keep the
# lightweight .cursor/rules/ + mcp.json so agent behavior stays
# version-controlled, but skip the heavy skill contents.
.cursor/skills/
.cursor/skills-cursor/

# Playwright cache & MCP artifacts (local test captures)
.playwright-mcp/
**/.playwright-mcp/
playwright-report/
test-results/

# Workspace scratch screenshots / design captures.
# These accumulate at the workspace root during design iterations
# and aren't part of the shipping app — the proposal-studio's
# `public/` folder holds all production assets.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

# Archives
*.zip
*.tar
*.tar.gz

# Scratch / tool output directories
tmp/
**/tmp/
output/imagegen/
**/output/imagegen/
tmp/imagegen/
**/tmp/imagegen/
