# ───────── LLM Configuration ─────────
# Proposal Studio picks the first provider with a configured API key, in this
# order: Anthropic → OpenAI → Google. The model envs are optional — each
# provider falls back to a sensible default if unset.

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-4.6-opus-high

# OpenAI (GPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-high

# Google (Gemini) — accepts either name
GOOGLE_API_KEY=
# GEMINI_API_KEY=
GOOGLE_MODEL=gemini-3.1-pro-preview
